<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Para ti 🌸</title>
    <style>
        /* Ajustes generales para que se vea perfecto en móvil */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #130b1f 0%, #2a1538 50%, #130b1f 100%);
            color: white;
            height: 100dvh;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        /* Contenedores de las pantallas */
        .pantalla {
            position: absolute;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: opacity 1.2s ease, transform 1.2s ease;
            padding: 20px;
        }

        .oculta {
            opacity: 0;
            pointer-events: none;
            transform: scale(0.95);
        }

        /* Pantalla 1: El corazón inicial */
        .pantalla-1 {
            z-index: 10;
            cursor: pointer;
        }

        .corazon {
            font-size: 60px;
            text-shadow: 0 0 20px rgba(255, 215, 0, 0.6);
            animation: latido 1.5s infinite;
            margin-bottom: 20px;
        }

        .icono-dedo {
            font-size: 30px;
            margin-bottom: 10px;
            animation: flotar 2s infinite ease-in-out;
        }

        .texto-portada h1 {
            font-size: 16px;
            letter-spacing: 4px;
            font-weight: 600;
            color: #ffd700;
            margin-bottom: 8px;
        }

        .texto-portada p {
            font-size: 12px;
            letter-spacing: 2px;
            color: #bfa3d4;
            opacity: 0.8;
        }

        /* Pantalla 2: El ramo de flores y el mensaje */
        .pantalla-2 {
            z-index: 5;
            background: radial-gradient(circle at center, rgba(60, 20, 80, 0.4) 0%, transparent 70%);
        }

        /* Animación del ramo */
        .ramo-contenedor {
            position: relative;
            width: 250px;
            height: 250px;
            margin-bottom: 30px;
        }

        .flor {
            position: absolute;
            font-size: 40px;
            opacity: 0;
            filter: drop-shadow(0 0 10px rgba(255, 102, 178, 0.5));
        }

        /* Posicionamiento para formar un ramo */
        .f1 { top: 20%; left: 30%; font-size: 55px; z-index: 3; } /* Lirio central rosa */
        .f2 { top: 35%; left: 10%; font-size: 45px; z-index: 2; }
        .f3 { top: 35%; left: 55%; font-size: 45px; z-index: 2; }
        .f4 { top: 10%; left: 15%; font-size: 40px; z-index: 1; }
        .f5 { top: 10%; left: 50%; font-size: 40px; z-index: 1; }
        .f6 { top: 50%; left: 30%; font-size: 60px; z-index: 4; } /* Base del ramo */

        /* Animación de entrada de las flores */
        .flor-animada {
            animation: florecer 1s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }
        
        .f1.flor-animada { animation-delay: 0.2s; }
        .f2.flor-animada { animation-delay: 0.4s; }
        .f3.flor-animada { animation-delay: 0.6s; }
        .f4.flor-animada { animation-delay: 0.5s; }
        .f5.flor-animada { animation-delay: 0.7s; }
        .f6.flor-animada { animation-delay: 0.1s; }

        .mensaje-romantico {
            max-width: 320px;
            line-height: 1.6;
        }

        .titulo-mensaje {
            font-size: 18px;
            color: #ffb3d9;
            margin-bottom: 15px;
            font-style: italic;
        }

        .texto-mensaje {
            font-size: 15px;
            color: #e6d3f8;
            font-weight: 300;
        }

        /* Keyframes */
        @keyframes latido {
            0% { transform: scale(1); }
            14% { transform: scale(1.15); }
            28% { transform: scale(1); }
            42% { transform: scale(1.15); }
            70% { transform: scale(1); }
        }

        @keyframes flotar {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }

        @keyframes florecer {
            0% { opacity: 0; transform: scale(0) translateY(30px) rotate(-15deg); }
            100% { opacity: 1; transform: scale(1) translateY(0) rotate(0); }
        }
    </style>
</head>
<body>

    <!-- PANTALLA 1: Botón de entrada -->
    <div id="intro" class="pantalla pantalla-1" onclick="abrirSorpresa()">
        <div class="corazon">💛</div>
        <div class="icono-dedo">👇</div>
        <div class="texto-portada">
            <h1>PARA TI</h1>
            <p>TOCA PARA ABRIR</p>
        </div>
    </div>

    <!-- PANTALLA 2: Ramo de flores y mensaje -->
    <div id="sorpresa" class="pantalla pantalla-2 oculta">
        
        <div class="ramo-contenedor">
            <!-- Flores distribuidas para formar el ramo. Los lirios y flores rosas destacan -->
            <div class="flor f6">💐</div>
            <div class="flor f4">🌸</div>
            <div class="flor f5">🌷</div>
            <div class="flor f2">🌺</div>
            <div class="flor f3">🌸</div>
            <div class="flor f1">🌺</div> 
        </div>

        <div class="mensaje-romantico">
            <h2 class="titulo-mensaje">"a ver qué me ha dicho mi novio"</h2>
            <p class="texto-mensaje">
                Igual que aquellos lirios rosas de nuestro primer día, quería dejarte estas flores por aquí también. <br><br>
                Te quiero mucho. 🤍
            </p>
        </div>

    </div>

    <script>
        function abrirSorpresa() {
            // Ocultar la pantalla 1
            const intro = document.getElementById('intro');
            intro.classList.add('oculta');

            // Mostrar la pantalla 2
            const sorpresa = document.getElementById('sorpresa');
            sorpresa.classList.remove('oculta');

            // Disparar la animación de las flores con un pequeño retraso
            setTimeout(() => {
                const flores = document.querySelectorAll('.flor');
                flores.forEach(flor => {
                    flor.classList.add('flor-animada');
                });
            }, 300);
        }
    </script>
</body>
</html>
